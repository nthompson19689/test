# Database
DATABASE_URL="postgresql://user:password@localhost:5432/transcript_assets?schema=public"

# S3-Compatible Storage
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_BUCKET="transcript-assets"

# Encryption (for user API keys)
ENCRYPTION_KEY="your-32-character-encryption-key"

# NextAuth (for web app)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Worker
WORKER_ID="worker-1"
WORKER_POLL_INTERVAL_MS="5000"

# Optional: Default LLM/Transcription API keys (fallback if user doesn't have BYOK)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""

# YouTube Data API (for Channel SEO Analyzer)
YOUTUBE_API_KEY=""
