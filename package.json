{
  "name": "transcript-to-assets-mvp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "lib"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "worker": "npm run start --workspace=apps/worker",
    "seo:dev": "npm run dev --workspace=apps/seo-report",
    "seo:build": "npm run build --workspace=apps/seo-report",
    "seo:start": "npm run start --workspace=apps/seo-report",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "prisma": "^5.19.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1"
  }
}
